# Copy to .env and adjust. Required for Docker Compose backend (LangGraph grading).
#
# Hugging Face Inference Endpoint OpenAI-compatible API base URL (must include /v1 mount).
HF_INFERENCE_BASE_URL=https://your-hf-endpoint.example/v1
# Model id exposed by that endpoint (must match the active grading catalog row’s OpenAI model id).
HF_OPENAI_MODEL=your-model-id

# Optional: read token for Hugging Face Hub (RAG downloads embedding/reranker models; higher rate limits).
# HF_TOKEN=hf_...

# SFT HTTP client (HF endpoint): shorter timeout and few retries to avoid multi-minute stalls.
# SFT_HTTP_TIMEOUT_SECONDS=90
# SFT_MAX_RETRIES=1

# Preload RAG models at API startup (recommended in Docker; set false to speed cold container start).
# RAG_WARMUP_ON_STARTUP=true

# Sandbox: student code using input() needs stdin. Default is many blank lines (see SANDBOX_STDIN_BLANK_LINES).
# For custom piped input use SANDBOX_STDIN=line1\\nline2\\n
# SANDBOX_STDIN_BLANK_LINES=512
