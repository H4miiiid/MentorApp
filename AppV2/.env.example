# Copy to .env and adjust. Required for Docker Compose backend (LangGraph grading).
#
# Hugging Face Inference Endpoint OpenAI-compatible API base URL (must include /v1 mount).
HF_INFERENCE_BASE_URL=https://your-hf-endpoint.example/v1
# Model id exposed by that endpoint (must match the active grading catalog row’s OpenAI model id).
HF_OPENAI_MODEL=your-model-id

# Optional: read token for Hugging Face Hub (RAG downloads embedding/reranker models; higher rate limits).
# HF_TOKEN=hf_...

# OpenRouter API for reflection hints, external fallback repair, and RAG summarization.
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_REFLECTION_MODEL=anthropic/claude-sonnet-4.6
# OPENROUTER_EXTERNAL_MODEL=anthropic/claude-opus-4.6
# OPENROUTER_SUMMARIZER_MODEL=openai/gpt-oss-120b
# OPENROUTER_HTTP_REFERER=https://your-app.example
# OPENROUTER_X_TITLE=MentorApp

# SFT HTTP client (HF endpoint): shorter timeout and few retries to avoid multi-minute stalls.
# SFT_HTTP_TIMEOUT_SECONDS=90
# SFT_MAX_RETRIES=1

# Preload RAG models at API startup (recommended in Docker; set false to speed cold container start).
# RAG_WARMUP_ON_STARTUP=true

# Sandbox: student code using input() needs stdin. Default is many blank lines (see SANDBOX_STDIN_BLANK_LINES).
# For custom piped input use SANDBOX_STDIN=line1\\nline2\\n
# SANDBOX_STDIN_BLANK_LINES=512

# Sandbox image: which Docker image is used to run student code.
# Default is `mentorapp-sandbox:latest`, built by the `sandbox-image` service in
# docker-compose.yml (see AppV2/sandbox/Dockerfile). It includes numpy, pandas,
# scipy, scikit-learn, matplotlib, seaborn, pyarrow, lxml, Pillow, statsmodels,
# sympy, networkx, requests, openpyxl, tqdm.
# Override to a leaner image (e.g. `python:3.13-slim-bookworm`) or a custom tag
# if you maintain your own curated image.
# SANDBOX_PYTHON_IMAGE=mentorapp-sandbox:latest

# Teacher Documents tab: per-file upload cap (MB). Defaults to 5.
# APPV2_DOCUMENT_MAX_UPLOAD_MB=5
# Comma-separated list of allowed extensions (leave unset to use the default teaching/data list).
# APPV2_DOCUMENT_ALLOWED_EXTS=.txt,.csv,.tsv,.json,.md,.pdf,.xlsx,.xls,.zip,.png,.jpg,.jpeg
