# Copy to .env and adjust. Required for Docker Compose backend (LangGraph grading).
#
# Remote llama.cpp OpenAI-compatible API base URL (e.g. Vast AI). Must match the server’s /v1 mount.
LLAMA_SERVER_URL=https://your-vast-host.example:port/v1
# Model id exposed by that server (must match the active grading catalog row’s OpenAI model id).
LLAMA_OPENAI_MODEL=your-model-id

# Optional: host dev only — auto-spawn local llama-server (not used in production Docker).
# LLAMA_SERVER_AUTO_START=false
